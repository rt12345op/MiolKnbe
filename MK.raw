})

-- 小窗自瞄
local function createSmallWindowAimbotUI()
    if smallWindowAimbotUI then
        smallWindowAimbotUI:Destroy()
        smallWindowAimbotUI = nil
    end
    
    smallWindowAimbotUI = Instance.new("ScreenGui")
    smallWindowAimbotUI.Name = "SmallWindowAimbotUI"
    smallWindowAimbotUI.Parent = game.CoreGui
    
    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(0, 180, 0, 120)
    mainFrame.Position = UDim2.new(0.8, 0, 0.2, 0)
    mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = smallWindowAimbotUI
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = mainFrame
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 25)
    title.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    title.Text = "独立自瞄开关"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 14
    title.Font = Enum.Font.SourceSansBold
    title.Parent = mainFrame
    
    local toggleButton = Instance.new("TextButton")
    toggleButton.Size = UDim2.new(0, 140, 0, 30)
    toggleButton.Position = UDim2.new(0.5, -70, 0, 35)
    toggleButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    toggleButton.Text = "自瞄: OFF"
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.TextSize = 14
    toggleButton.Font = Enum.Font.SourceSansBold
    toggleButton.Parent = mainFrame
    
    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 6)
    buttonCorner.Parent = toggleButton
    
    local warningLabel = Instance.new("TextLabel")
    warningLabel.Size = UDim2.new(1, 0, 0, 20)
    warningLabel.Position = UDim2.new(0, 0, 0, 70)
    warningLabel.BackgroundTransparency = 1
    warningLabel.Text = "不要与主UI自瞄同时开启"
    warningLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    warningLabel.TextSize = 10
    warningLabel.Font = Enum.Font.SourceSans
    warningLabel.Parent = mainFrame
    
    -- 平滑度输入框
    local smoothnessBox = Instance.new("TextBox")
    smoothnessBox.Size = UDim2.new(0, 60, 0, 20)
    smoothnessBox.Position = UDim2.new(0.5, -30, 0, 95)
    smoothnessBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    smoothnessBox.Text = "0.08"
    smoothnessBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    smoothnessBox.TextSize = 12
    smoothnessBox.Font = Enum.Font.SourceSans
    smoothnessBox.PlaceholderText = "平滑度"
    smoothnessBox.ClearTextOnFocus = false
    smoothnessBox.Parent = mainFrame
    
    local smoothnessCorner = Instance.new("UICorner")
    smoothnessCorner.CornerRadius = UDim.new(0, 4)
    smoothnessCorner.Parent = smoothnessBox
    
    -- 平滑度标签
    local smoothnessLabel = Instance.new("TextLabel")
    smoothnessLabel.Size = UDim2.new(0, 60, 0, 20)
    smoothnessLabel.Position = UDim2.new(0.5, -100, 0, 95)
    smoothnessLabel.BackgroundTransparency = 1
    smoothnessLabel.Text = "平滑度:"
    smoothnessLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    smoothnessLabel.TextSize = 12
    smoothnessLabel.Font = Enum.Font.SourceSans
    smoothnessLabel.Parent = mainFrame
    
    toggleButton.MouseButton1Click:Connect(function()
        smallWindowAimbotEnabled = not smallWindowAimbotEnabled
        toggleButton.Text = smallWindowAimbotEnabled and "自瞄: ON" or "自瞄: OFF"
        toggleButton.BackgroundColor3 = smallWindowAimbotEnabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
        
        if smallWindowAimbotEnabled then
            if aimbotEnabled then
                aimbotEnabled = false
                if connections.aimbot then
                    connections.aimbot:Disconnect()
                    connections.aimbot = nil
                end
            end
            -- 启动小窗自瞄逻辑
            if not connections.smallAimbot then
                local targetHistory = {}
                local function FindTarget()
                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
                    local myRoot = char.HumanoidRootPart
                    local myPos = myRoot.Position
                    local closestTarget = nil
                    local shortestDist = AIM_MAX_RANGE
                    for _, player in pairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            local targetRoot = player.Character.HumanoidRootPart
                            local dist = (myPos - targetRoot.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                closestTarget = targetRoot
                            end
                        end
                    end
                    return closestTarget
                end
                connections.smallAimbot = RunService.RenderStepped:Connect(function()
                    if not smallWindowAimbotEnabled then return end
                    local target = FindTarget()
                    if not target then return end
                    local cameraPos = Camera.CFrame.Position
                    local direction = (target.Position - cameraPos).Unit
                    local targetCFrame = CFrame.lookAt(cameraPos, cameraPos + direction)
                    
                    -- 使用输入框中的平滑度值
                    local smoothness = tonumber(smoothnessBox.Text) or 0.08
                    smoothness = math.clamp(smoothness, 0.01, 0.8)
                    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, smoothness)
                end)
            end
        else
            if connections.smallAimbot then
                connections.smallAimbot:Disconnect()
                connections.smallAimbot = nil
            end
        end
    end)
    
    -- 平滑度输入验证
    smoothnessBox.FocusLost:Connect(function()
        local value = tonumber(smoothnessBox.Text)
        if value then
            value = math.clamp(value, 0.01, 0.8)
            smoothnessBox.Text = string.format("%.2f", value)
        else
            smoothnessBox.Text = "0.08"
        end
    end)
    
    -- 关闭按钮
    local closeButton = Instance.new("TextButton")
    closeButton.Size = UDim2.new(0, 20, 0, 20)
    closeButton.Position = UDim2.new(1, -25, 0, 2)
    closeButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    closeButton.Text = "X"
    closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeButton.TextSize = 12
    closeButton.Font = Enum.Font.SourceSansBold
    closeButton.Parent = mainFrame
    
    closeButton.MouseButton1Click:Connect(function()
        smallWindowAimbotUI:Destroy()
        smallWindowAimbotUI = nil
        smallWindowAimbotEnabled = false
        if connections.smallAimbot then
            connections.smallAimbot:Disconnect()
            connections.smallAimbot = nil
        end
    end)
end

