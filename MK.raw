local MiniContainer = Instance.new("TextButton")
MiniContainer.Size = UDim2.new(0, 40, 0, 40)
MiniContainer.Position = UDim2.new(1, -50, 1, -50)
MiniContainer.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
MiniContainer.BackgroundTransparency = 0.3
MiniContainer.BorderSizePixel = 0
