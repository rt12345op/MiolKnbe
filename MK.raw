local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

WindUI.TransparencyValue = 0.2
WindUI:SetTheme("Dark")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local originalLighting = {
    Brightness = Lighting.Brightness,
    Ambient = Lighting.Ambient,
    ColorShift_Top = Lighting.ColorShift_Top,
    ColorShift_Bottom = Lighting.ColorShift_Bottom,
    FogEnd = Lighting.FogEnd,
    FogStart = Lighting.FogStart,
    GlobalShadows = Lighting.GlobalShadows
}

local connections = {}
local PlayerHighlights = {}
local NPCHighlights = {}
local centerCircle = nil
local aimbotEnabled = false
local highlightEnabled = false
local fogRemoved = false
local autoFrameEnabled = false

local PlayerESPRange = 20
local NPCESPRange = 20
local AIM_MAX_RANGE = 300
local AIM_SMOOTHNESS = 0.15
local PREDICTION_TIME = 0.12
local autoFrameRadius = 10

local Window = WindUI:CreateWindow({
    Title = "三角洲项目xk",
    Icon = "target",
    Author = "xk项目开发组",
    Folder = "DeltaProjectXK",
    Size = UDim2.fromOffset(800, 600),
    Theme = "Dark",
    User = {Enabled = true, Callback = function() end},
    SideBarWidth = 220,
    ScrollBarEnabled = true
})

Window:Tag({Title = "v1.0", Color = Color3.fromHex("#306aff")})

local AnnouncementTab = Window:Tab({Title = "公告", Icon = "app-window", Locked = false})
AnnouncementTab:Paragraph({
    Title = "三角洲项目xk v1.0",
    Image = "nil",
    ImageSize = 20,
    Color = "Grey",
    Buttons = {{
        Title = "复制项目地址",
        Icon = "copy",
        Variant = "Tertiary",
        Callback = function() setclipboard("https://github.com/DeltaProjectXK") end
    }}
})

local EspTab = Window:Tab({Title = "透视功能", Icon = "eye", Locked = false})

local PlayerEspToggle = EspTab:Toggle({
    Title = "玩家透视",
    Desc = "显示所有玩家的位置和血量",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        if state then
            if not connections.playerEsp then
                connections.playerEsp = RunService.RenderStepped:Connect(function()
                    local localCharacter = LocalPlayer.Character
                    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return end
                    local localPosition = localCharacter.HumanoidRootPart.Position
                    
                    for _, plr in pairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character:FindFirstChild("Head") then
                            local targetPosition = plr.Character.HumanoidRootPart.Position
                            local distance = (targetPosition - localPosition).Magnitude
                            
                            if distance <= PlayerESPRange then
                                if not PlayerHighlights[plr] then
                                    local highlight = Instance.new("Highlight")
                                    highlight.Adornee = plr.Character
                                    highlight.FillColor = Color3.fromRGB(0, 255, 0)
                                    highlight.FillTransparency = 0.8
                                    highlight.OutlineColor = Color3.fromRGB(50, 255, 50)
                                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                    highlight.Parent = plr.Character
                                    
                                    local billboard = Instance.new("BillboardGui")
                                    billboard.Size = UDim2.new(0, 120, 0, 40)
                                    billboard.Adornee = plr.Character.Head
                                    billboard.AlwaysOnTop = true
                                    billboard.StudsOffset = Vector3.new(0, 2, 0)
                                    billboard.Parent = plr.Character.Head
                                    
                                    local nameLabel = Instance.new("TextLabel")
                                    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
                                    nameLabel.BackgroundTransparency = 1
                                    nameLabel.TextColor3 = Color3.fromRGB(200, 255, 200)
                                    nameLabel.TextStrokeTransparency = 0
                                    nameLabel.Text = plr.Name
                                    nameLabel.Parent = billboard
                                    
                                    local healthLabel = Instance.new("TextLabel")
                                    healthLabel.Size = UDim2.new(1, 0, 0.5, 0)
                                    healthLabel.Position = UDim2.new(0, 0, 0.5, 0)
                                    healthLabel.BackgroundTransparency = 1
                                    healthLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                                    healthLabel.TextStrokeTransparency = 0
                                    healthLabel.Text = "HP: " .. math.floor(plr.Character.Humanoid.Health)
                                    healthLabel.Parent = billboard
                                    
                                    PlayerHighlights[plr] = {Highlight = highlight, Billboard = billboard, HealthLabel = healthLabel}
                                else
                                    PlayerHighlights[plr].HealthLabel.Text = "HP: " .. math.floor(plr.Character.Humanoid.Health)
                                end
                            else
                                if PlayerHighlights[plr] then
                                    if PlayerHighlights[plr].Highlight then PlayerHighlights[plr].Highlight:Destroy() end
                                    if PlayerHighlights[plr].Billboard then PlayerHighlights[plr].Billboard:Destroy() end
                                    PlayerHighlights[plr] = nil
                                end
                            end
                        end
                    end
                end)
            end
        else
            if connections.playerEsp then
                connections.playerEsp:Disconnect()
                connections.playerEsp = nil
            end
            for _, data in pairs(PlayerHighlights) do 
                if data.Highlight then data.Highlight:Destroy() end 
                if data.Billboard then data.Billboard:Destroy() end 
            end
            PlayerHighlights = {}
        end
    end
})

local PlayerEspRangeSlider = EspTab:Slider({
    Title = "玩家透视范围",
    Step = 1,
    Value = {Min = 0, Max = 1000, Default = 20},
    Callback = function(value) PlayerESPRange = value end
})

local NpcEspToggle = EspTab:Toggle({
    Title = "NPC透视",
    Desc = "显示所有NPC的位置和血量",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        if state then
            if not connections.npcEsp then
                connections.npcEsp = RunService.RenderStepped:Connect(function()
                    local localCharacter = LocalPlayer.Character
                    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return end
                    local localPosition = localCharacter.HumanoidRootPart.Position
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("Head") and not Players:GetPlayerFromCharacter(obj) then
                            local targetPosition = obj.HumanoidRootPart.Position
                            local distance = (targetPosition - localPosition).Magnitude
                            
                            if distance <= NPCESPRange then
                                if not NPCHighlights[obj] then
                                    local highlight = Instance.new("Highlight")
                                    highlight.Adornee = obj
                                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                                    highlight.FillTransparency = 0.8
                                    highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
                                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                    highlight.Parent = obj
                                    
                                    local billboard = Instance.new("BillboardGui")
                                    billboard.Size = UDim2.new(0, 120, 0, 40)
                                    billboard.Adornee = obj.Head
                                    billboard.AlwaysOnTop = true
                                    billboard.StudsOffset = Vector3.new(0, 2, 0)
                                    billboard.Parent = obj.Head
                                    
                                    local nameLabel = Instance.new("TextLabel")
                                    nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
                                    nameLabel.BackgroundTransparency = 1
                                    nameLabel.TextColor3 = Color3.fromRGB(255, 200, 200)
                                    nameLabel.TextStrokeTransparency = 0
                                    nameLabel.Text = obj.Name
                                    nameLabel.Parent = billboard
                                    
                                    local healthLabel = Instance.new("TextLabel")
                                    healthLabel.Size = UDim2.new(1, 0, 0.5, 0)
                                    healthLabel.Position = UDim2.new(0, 0, 0.5, 0)
                                    healthLabel.BackgroundTransparency = 1
                                    healthLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                                    healthLabel.TextStrokeTransparency = 0
                                    healthLabel.Text = "HP: " .. math.floor(obj.Humanoid.Health)
                                    healthLabel.Parent = billboard
                                    
                                    NPCHighlights[obj] = {Highlight = highlight, Billboard = billboard, HealthLabel = healthLabel}
                                else
                                    NPCHighlights[obj].HealthLabel.Text = "HP: " .. math.floor(obj.Humanoid.Health)
                                end
                            else
                                if NPCHighlights[obj] then
                                    if NPCHighlights[obj].Highlight then NPCHighlights[obj].Highlight:Destroy() end
                                    if NPCHighlights[obj].Billboard then NPCHighlights[obj].Billboard:Destroy() end
                                    NPCHighlights[obj] = nil
                                end
                            end
                        end
                    end
                end)
            end
        else
            if connections.npcEsp then
                connections.npcEsp:Disconnect()
                connections.npcEsp = nil
            end
            for _, data in pairs(NPCHighlights) do 
                if data.Highlight then data.Highlight:Destroy() end 
                if data.Billboard then data.Billboard:Destroy() end 
            end
            NPCHighlights = {}
        end
    end
})

local NpcEspRangeSlider = EspTab:Slider({
    Title = "NPC透视范围",
    Step = 1,
    Value = {Min = 0, Max = 1000, Default = 20},
    Callback = function(value) NPCESPRange = value end
})

local AimbotTab = Window:Tab({Title = "自瞄功能", Icon = "crosshair", Locked = false})

local AimbotToggle = AimbotTab:Toggle({
    Title = "平滑自瞄",
    Desc = "自动瞄准敌人，带预判功能",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        aimbotEnabled = state
        if state then
            if not connections.aimbot then
                local targetHistory = {}
                local lastTarget = nil
                
                local function FindTarget()
                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
                    
                    local myRoot = char.HumanoidRootPart
                    local myPos = myRoot.Position
                    local closestTarget = nil
                    local shortestDist = AIM_MAX_RANGE
                    
                    -- 检查玩家
                    for _, player in pairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
                            local targetHead = player.Character.Head
                            local dist = (myPos - targetHead.Position).Magnitude
                            
                            if dist < shortestDist then
                                shortestDist = dist
                                closestTarget = targetHead
                            end
                        end
                    end
                    
                    -- 检查NPC
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:FindFirstChild("Head") and not Players:GetPlayerFromCharacter(obj) then
                            local targetHead = obj.Head
                            local dist = (myPos - targetHead.Position).Magnitude
                            
                            if dist < shortestDist then
                                shortestDist = dist
                                closestTarget = targetHead
                            end
                        end
                    end
                    
                    return closestTarget
                end
                
                local function PredictPosition(target, currentPos)
                    local targetId = tostring(target:GetDebugId())
                    if not targetHistory[targetId] then
                        targetHistory[targetId] = {lastPos = currentPos, lastTime = tick(), velocity = Vector3.new(0, 0, 0)}
                        return currentPos
                    end
                    
                    local history = targetHistory[targetId]
                    local currentTime = tick()
                    local deltaTime = currentTime - history.lastTime
                    
                    if deltaTime > 0 then
                        local velocity = (currentPos - history.lastPos) / deltaTime
                        history.velocity = history.velocity:Lerp(velocity, 0.2)
                        local predictedPos = currentPos + (history.velocity * PREDICTION_TIME)
                        history.lastPos = currentPos
                        history.lastTime = currentTime
                        return predictedPos
                    end
                    return currentPos
                end
                
                connections.aimbot = RunService.RenderStepped:Connect(function()
                    if not aimbotEnabled then return end
                    
                    local target = FindTarget()
                    if not target then return end
                    
                    local currentPos = target.Position
                    local predictedPos = PredictPosition(target, currentPos)
                    local cameraPos = Camera.CFrame.Position
                    
                    -- 计算目标方向
                    local direction = (predictedPos - cameraPos).Unit
                    local targetCFrame = CFrame.lookAt(cameraPos, cameraPos + direction)
                    
                    -- 平滑过渡
                    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, AIM_SMOOTHNESS)
                end)
            end
        else
            if connections.aimbot then
                connections.aimbot:Disconnect()
                connections.aimbot = nil
            end
        end
    end
})

local AimbotRangeSlider = AimbotTab:Slider({
    Title = "自瞄范围",
    Step = 1,
    Value = {Min = 1, Max = 1000, Default = 300},
    Callback = function(value) AIM_MAX_RANGE = value end
})

local AimbotSmoothnessSlider = AimbotTab:Slider({
    Title = "自瞄平滑度",
    Step = 0.01,
    Value = {Min = 0.05, Max = 0.3, Default = 0.15},
    Callback = function(value) AIM_SMOOTHNESS = value end
})

local VisualTab = Window:Tab({Title = "视觉效果", Icon = "sun", Locked = false})

local HighlightToggle = VisualTab:Toggle({
    Title = "全局高亮",
    Desc = "提高整体亮度",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        if state then
            Lighting.Brightness = 5
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)
            Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)
        else
            Lighting.Brightness = originalLighting.Brightness
            Lighting.Ambient = originalLighting.Ambient
            Lighting.ColorShift_Top = originalLighting.ColorShift_Top
            Lighting.ColorShift_Bottom = originalLighting.ColorShift_Bottom
        end
    end
})

local RemoveFogToggle = VisualTab:Toggle({
    Title = "去除雾和阴影",
    Desc = "移除地图中的雾效和阴影",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        if state then
            Lighting.FogEnd = 100000
            Lighting.FogStart = 100000
            Lighting.GlobalShadows = false
        else
            Lighting.FogEnd = originalLighting.FogEnd
            Lighting.FogStart = originalLighting.FogStart
            Lighting.GlobalShadows = originalLighting.GlobalShadows
        end
    end
})

local AutoFrameTab = Window:Tab({Title = "自描框", Icon = "circle", Locked = false})

local function createCenterCircle(radius)
    if centerCircle then
        centerCircle:Destroy()
        centerCircle = nil
    end
    
    centerCircle = Instance.new("Frame")
    centerCircle.Name = "CenterCircle"
    centerCircle.Size = UDim2.new(0, radius * 2, 0, radius * 2)
    centerCircle.Position = UDim2.new(0.5, -radius, 0.5, -radius)
    centerCircle.BackgroundTransparency = 1
    centerCircle.BorderSizePixel = 0
    centerCircle.Parent = Window.ScreenGui
    
    local circleBorder = Instance.new("UIStroke")
    circleBorder.Color = Color3.fromRGB(255, 255, 255)
    circleBorder.Thickness = 2
    circleBorder.Parent = centerCircle
    
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = centerCircle
end

local AutoFrameToggle = AutoFrameTab:Toggle({
    Title = "自描框",
    Desc = "在屏幕正中心显示圆环",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        autoFrameEnabled = state
        if state then
            createCenterCircle(autoFrameRadius)
        else
            if centerCircle then
                centerCircle:Destroy()
                centerCircle = nil
            end
        end
    end
})

local AutoFrameRadiusSlider = AutoFrameTab:Slider({
    Title = "自描框半径",
    Step = 1,
    Value = {Min = 1, Max = 100, Default = 10},
    Callback = function(value)
        autoFrameRadius = value
        if autoFrameEnabled then
            createCenterCircle(autoFrameRadius)
        end
    end
})

local SettingsTab = Window:Tab({Title = "设置", Icon = "settings", Locked = false})

local ThemeDropdown = SettingsTab:Dropdown({
    Title = "主题选择",
    Values = {"Dark", "Light", "Blue", "Green", "Red"},
    Value = "Dark",
    Callback = function(option) WindUI:SetTheme(option) end
})

local TransparencySlider = SettingsTab:Slider({
    Title = "UI透明度",
    Step = 0.05,
    Value = {Min = 0, Max = 1, Default = 0.2},
    Callback = function(value) WindUI.TransparencyValue = value end
})

local ResetButton = SettingsTab:Button({
    Title = "重置所有设置",
    Locked = false,
    Callback = function()
        for _, conn in pairs(connections) do if conn then conn:Disconnect() end end
        for _, data in pairs(PlayerHighlights) do if data.Highlight then data.Highlight:Destroy() end end
        for _, data in pairs(NPCHighlights) do if data.Highlight then data.Highlight:Destroy() end end
        
        Lighting.Brightness = originalLighting.Brightness
        Lighting.Ambient = originalLighting.Ambient
        Lighting.ColorShift_Top = originalLighting.ColorShift_Top
        Lighting.ColorShift_Bottom = originalLighting.ColorShift_Bottom
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.FogStart = originalLighting.FogStart
        Lighting.GlobalShadows = originalLighting.GlobalShadows
        
        if centerCircle then
            centerCircle:Destroy()
            centerCircle = nil
        end
        
        PlayerHighlights = {}
        NPCHighlights = {}
        connections = {}
        aimbotEnabled = false
        highlightEnabled = false
        fogRemoved = false
        autoFrameEnabled = false
        
        PlayerEspToggle:Set(false)
        NpcEspToggle:Set(false)
        AimbotToggle:Set(false)
        HighlightToggle:Set(false)
        RemoveFogToggle:Set(false)
        AutoFrameToggle:Set(false)
        PlayerEspRangeSlider:Set(20)
        NpcEspRangeSlider:Set(20)
        AimbotRangeSlider:Set(300)
        AimbotSmoothnessSlider:Set(0.15)
        AutoFrameRadiusSlider:Set(10)
        ThemeDropdown:Set("Dark")
        TransparencySlider:Set(0.2)
    end
})

local CloseButton = SettingsTab:Button({
    Title = "关闭脚本",
    Locked = false,
    Callback = function()
        for _, conn in pairs(connections) do if conn then conn:Disconnect() end end
        for _, data in pairs(PlayerHighlights) do if data.Highlight then data.Highlight:Destroy() end end
        for _, data in pairs(NPCHighlights) do if data.Highlight then data.Highlight:Destroy() end end
        
        Lighting.Brightness = originalLighting.Brightness
        Lighting.Ambient = originalLighting.Ambient
        Lighting.ColorShift_Top = originalLighting.ColorShift_Top
        Lighting.ColorShift_Bottom = originalLighting.ColorShift_Bottom
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.FogStart = originalLighting.FogStart
        Lighting.GlobalShadows = originalLighting.GlobalShadows
        
        if centerCircle then
            centerCircle:Destroy()
            centerCircle = nil
        end
        
        Window:Destroy()
    end
})

print("三角洲项目xk v1.0 已成功加载！所有功能已就绪。")
