-- ESP区域
EspTab:Section({ Title = "玩家透视", Text = "显示所有玩家的位置和血量" })

local PlayerEspToggle = EspTab:Toggle({
    Title = "玩家透视",
    Desc = "显示所有玩家的位置和血量",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        espEnabled = state
        if state then
            if not connections.playerEsp then
                connections.playerEsp = RunService.RenderStepped:Connect(function()
                    local localCharacter = LocalPlayer.Character
                    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return end
                    local localPosition = localCharacter.HumanoidRootPart.Position
                    for _, plr in pairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character:FindFirstChild("Head") then
                            local targetPosition = plr.Character.HumanoidRootPart.Position
                            local distance = (targetPosition - localPosition).Magnitude
                            if distance <= PlayerESPRange then
                                if not PlayerHighlights[plr] then
                                    local highlight = Instance.new("Highlight")
                                    highlight.Adornee = plr.Character
                                    highlight.FillColor = Color3.fromRGB(0, 255, 0)
                                    highlight.FillTransparency = 0.8
                                    highlight.OutlineColor = Color3.fromRGB(50, 255, 50)
                                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                    highlight.Parent = plr.Character
                                    local billboard = Instance.new("BillboardGui")
                                    billboard.Size = UDim2.new(0, 120, 0, 60)
                                    billboard.Adornee = plr.Character.Head
                                    billboard.AlwaysOnTop = true
                                    billboard.StudsOffset = Vector3.new(0, 2, 0)
                                    billboard.Parent = plr.Character.Head
                                    
                                    local nameLabel = Instance.new("TextLabel")
                                    nameLabel.Size = UDim2.new(1, 0, 0.33, 0)
                                    nameLabel.BackgroundTransparency = 1
                                    nameLabel.TextColor3 = Color3.fromRGB(200, 255, 200)
                                    nameLabel.TextStrokeTransparency = 0
                                    nameLabel.Text = plr.Name
                                    nameLabel.Parent = billboard
                                    
                                    local healthLabel = Instance.new("TextLabel")
                                    healthLabel.Size = UDim2.new(1, 0, 0.33, 0)
                                    healthLabel.Position = UDim2.new(0, 0, 0.33, 0)
                                    healthLabel.BackgroundTransparency = 1
                                    healthLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
                                    healthLabel.TextStrokeTransparency = 0
                                    healthLabel.Text = "HP: " .. math.floor(plr.Character.Humanoid.Health)
                                    healthLabel.Parent = billboard
                                    
                                    local distanceLabel = Instance.new("TextLabel")
                                    distanceLabel.Size = UDim2.new(1, 0, 0.33, 0)
                                    distanceLabel.Position = UDim2.new(0, 0, 0.66, 0)
                                    distanceLabel.BackgroundTransparency = 1
                                    distanceLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
                                    distanceLabel.TextStrokeTransparency = 0
                                    distanceLabel.Text = "距离: " .. math.floor(distance) .. "m"
                                    distanceLabel.Parent = billboard
                                    
                                    PlayerHighlights[plr] = {Highlight = highlight, Billboard = billboard, HealthLabel = healthLabel, DistanceLabel = distanceLabel, Humanoid = plr.Character.Humanoid}
                                else
                                    if PlayerHighlights[plr].Humanoid then
                                        PlayerHighlights[plr].HealthLabel.Text = "HP: " .. math.floor(PlayerHighlights[plr].Humanoid.Health)
                                        PlayerHighlights[plr].DistanceLabel.Text = "距离: " .. math.floor((plr.Character.HumanoidRootPart.Position - localPosition).Magnitude) .. "m"
                                    end
                                end
                            else
                                if PlayerHighlights[plr] then
                                    if PlayerHighlights[plr].Highlight then PlayerHighlights[plr].Highlight:Destroy() end
                                    if PlayerHighlights[plr].Billboard then PlayerHighlights[plr].Billboard:Destroy() end
                                    PlayerHighlights[plr] = nil
                                end
                            end
                        end
                    end
                end)
            end
        else
            if connections.playerEsp then
                connections.playerEsp:Disconnect()
                connections.playerEsp = nil
            end
            for _, data in pairs(PlayerHighlights) do 
                if data.Highlight then data.Highlight:Destroy() end 
                if data.Billboard then data.Billboard:Destroy() end 
            end
            PlayerHighlights = {}
        end
    end
})

EspTab:Slider({
    Title = "玩家透视范围",
    Step = 1,
    Value = {
        Min = 0,
        Max = 1000,
        Default = 20,
    },
    Callback = function(value)
        PlayerESPRange = value
    end
})

EspTab:Toggle({
    Title = "文本显示",
    Desc = "关闭则只显示骨骼",
    Type = "Checkbox",
    Default = true,
    Callback = function(state)
        espTextEnabled = state
        -- 更新所有现有ESP的文本显示状态
        for _, data in pairs(PlayerHighlights) do
            if data.Billboard then
                data.Billboard.Enabled = state
            end
        end
        for _, data in pairs(NPCHighlights) do
            if data.Billboard then
                data.Billboard.Enabled = state
            end
        end
    end
})

EspTab:Toggle({
    Title = "射线追踪",
    Desc = "从屏幕上方射到玩家头顶",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        rayEnabled = state
        if state then
            if not connections.ray then
                connections.ray = RunService.RenderStepped:Connect(function()
                    if not espEnabled then return end
                    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, 0)
                    for _, plr in pairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                            local head = plr.Character.Head
                            local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                            if onScreen then
                                local ray = Drawing.new("Line")
                                ray.From = screenCenter
                                ray.To = Vector2.new(headPos.X, headPos.Y)
                                ray.Color = Color3.fromRGB(255, 255, 255)
                                ray.Thickness = 1
                                ray.Transparency = 1
                                ray.Visible = true
                                task.wait(0.01)
                                ray:Remove()
                            end
                        end
                    end
                end)
            end
        else
            if connections.ray then
                connections.ray:Disconnect()
                connections.ray = nil
            end
        end
    end
})

local NpcEspToggle = EspTab:Toggle({
    Title = "NPC透视",
    Desc = "显示所有NPC的位置和血量",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        if state then
            if not connections.npcEsp then
                connections.npcEsp = RunService.RenderStepped:Connect(function()
                    local localCharacter = LocalPlayer.Character
                    if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return end
                    local localPosition = localCharacter.HumanoidRootPart.Position
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("Head") and not Players:GetPlayerFromCharacter(obj) then
                            local targetPosition = obj.HumanoidRootPart.Position
                            local distance = (targetPosition - localPosition).Magnitude
                            if distance <= NPCESPRange then
                                if not NPCHighlights[obj] then
                                    local highlight = Instance.new("Highlight")
                                    highlight.Adornee = obj
                                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                                    highlight.FillTransparency = 0.8
                                    highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
                                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                    highlight.Parent = obj
                                    local billboard = Instance.new("BillboardGui")
                                    billboard.Size = UDim2.new(0, 120, 0, 60)
                                    billboard.Adornee = obj.Head
                                    billboard.AlwaysOnTop = true
                                    billboard.StudsOffset = Vector3.new(0, 2, 0)
                                    billboard.Parent = obj.Head
                                    
                                    local nameLabel = Instance.new("TextLabel")
                                    nameLabel.Size = UDim2.new(1, 0, 0.33, 0)
                                    nameLabel.BackgroundTransparency = 1
                                    nameLabel.TextColor3 = Color3.fromRGB(255, 200, 200)
                                    nameLabel.TextStrokeTransparency = 0
                                    nameLabel.Text = obj.Name
                                    nameLabel.Parent = billboard
                                    
                                    local healthLabel = Instance.new("TextLabel")
                                    healthLabel.Size = UDim2.new(1, 0, 0.33, 0)
                                    healthLabel.Position = UDim2.new(0, 0, 0.33, 0)
                                    healthLabel.BackgroundTransparency = 1
                                    healthLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                                    healthLabel.TextStrokeTransparency = 0
                                    healthLabel.Text = "HP: " .. math.floor(obj.Humanoid.Health)
                                    healthLabel.Parent = billboard
                                    
                                    local distanceLabel = Instance.new("TextLabel")
                                    distanceLabel.Size = UDim2.new(1, 0, 0.33, 0)
                                    distanceLabel.Position = UDim2.new(0, 0, 0.66, 0)
                                    distanceLabel.BackgroundTransparency = 1
                                    distanceLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
                                    distanceLabel.TextStrokeTransparency = 0
                                    distanceLabel.Text = "距离: " .. math.floor(distance) .. "m"
                                    distanceLabel.Parent = billboard
                                    
                                    NPCHighlights[obj] = {Highlight = highlight, Billboard = billboard, HealthLabel = healthLabel, DistanceLabel = distanceLabel, Humanoid = obj.Humanoid}
                                else
                                    if NPCHighlights[obj].Humanoid then
                                        NPCHighlights[obj].HealthLabel.Text = "HP: " .. math.floor(NPCHighlights[obj].Humanoid.Health)
                                        NPCHighlights[obj].DistanceLabel.Text = "距离: " .. math.floor((obj.HumanoidRootPart.Position - localPosition).Magnitude) .. "m"
                                    end
                                end
                            else
                                if NPCHighlights[obj] then
                                    if NPCHighlights[obj].Highlight then NPCHighlights[obj].Highlight:Destroy() end
                                    if NPCHighlights[obj].Billboard then NPCHighlights[obj].Billboard:Destroy() end
                                    NPCHighlights[obj] = nil
                                end
                            end
                        end
                    end
                end)
            end
        else
            if connections.npcEsp then
                connections.npcEsp:Disconnect()
                connections.npcEsp = nil
            end
            for _, data in pairs(NPCHighlights) do 
                if data.Highlight then data.Highlight:Destroy() end 
                if data.Billboard then data.Billboard:Destroy() end 
            end
            NPCHighlights = {}
        end
    end
})

local NpcEspRangeSlider = EspTab:Slider({
    Title = "NPC透视范围",
    Step = 1,
    Value = {
        Min = 0,
        Max = 1000,
        Default = 20,
    },
    Callback = function(value)
        NPCESPRange = value
    end
})

local VisualTab = Window:Tab({
    Title = "视觉效果",
    Icon = "sun",
    Locked = false,
})

local HighlightToggle = VisualTab:Toggle({
    Title = "全局高亮",
    Desc = "提高整体亮度",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        highlightEnabled = state
        if state then
            Lighting.Brightness = 5
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.ColorShift_Top = Color3.fromRGB(255, 255, 255)
            Lighting.ColorShift_Bottom = Color3.fromRGB(255, 255, 255)
        else
            Lighting.Brightness = originalLighting.Brightness
            Lighting.Ambient = originalLighting.Ambient
            Lighting.ColorShift_Top = originalLighting.ColorShift_Top
            Lighting.ColorShift_Bottom = originalLighting.ColorShift_Bottom
        end
    end
})

local RemoveFogToggle = VisualTab:Toggle({
    Title = "去除雾和阴影",
    Desc = "移除地图中的雾效和阴影",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        fogRemoved = state
        if state then
            Lighting.FogEnd = 100000
            Lighting.FogStart = 100000
            Lighting.GlobalShadows = false
        else
            Lighting.FogEnd = originalLighting.FogEnd
            Lighting.FogStart = originalLighting.FogStart
            Lighting.GlobalShadows = originalLighting.GlobalShadows
        end
    end
})

VisualTab:Slider({
    Title = "视角FOV范围",
    Step = 1,
    Value = {
        Min = 60,
        Max = 120,
        Default = 70,
    },
    Callback = function(value)
        ViewFOV = value
        Camera.FieldOfView = ViewFOV
    end
})

local SettingsTab = Window:Tab({
    Title = "设置",
    Icon = "settings",
    Locked = false,
})

local ThemeDropdown = SettingsTab:Dropdown({
    Title = "主题选择",
    Values = { "Dark", "Light", "Blue", "Green", "Red" },
    Value = "Dark",
    Callback = function(option)
        WindUI:SetTheme(option)
    end
})

local TransparencySlider = SettingsTab:Slider({
    Title = "UI透明度",
    Step = 0.05,
    Value = {
        Min = 0,
        Max = 1,
        Default = 0.2,
    },
    Callback = function(value)
        WindUI.TransparencyValue = value
    end
})

local ResetButton = SettingsTab:Button({
    Title = "重置所有设置",
    Locked = false,
    Callback = function()
        -- 断开所有连接
        for _, conn in pairs(connections) do 
            if conn then 
                conn:Disconnect() 
            end 
        end
        
        -- 销毁所有ESP
        for _, data in pairs(PlayerHighlights) do 
            if data.Highlight then data.Highlight:Destroy() end 
            if data.Billboard then data.Billboard:Destroy() end 
        end
        for _, data in pairs(NPCHighlights) do 
            if data.Highlight then data.Highlight:Destroy() end 
            if data.Billboard then data.Billboard:Destroy() end 
        end
        
        -- 恢复光照设置
        Lighting.Brightness = originalLighting.Brightness
        Lighting.Ambient = originalLighting.Ambient
        Lighting.ColorShift_Top = originalLighting.ColorShift_Top
        Lighting.ColorShift_Bottom = originalLighting.ColorShift_Bottom
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.FogStart = originalLighting.FogStart
        Lighting.GlobalShadows = originalLighting.GlobalShadows
        
        -- 销毁FOV框
        if fovCircle then
            fovCircle:Destroy()
            fovCircle = nil
        end
        
        -- 销毁小窗自瞄UI
        if smallWindowAimbotUI then
            smallWindowAimbotUI:Destroy()
            smallWindowAimbotUI = nil
        end
        
        -- 重置变量
        PlayerHighlights = {}
        NPCHighlights = {}
        connections = {}
        bulletTrackingEnabled = false
        bulletTracking.enable = false
        bulletTracking.hooked = false
        aimbotEnabled = false
        smallWindowAimbotEnabled = false
        highlightEnabled = false
        fogRemoved = false
        fovEnabled = false
        espEnabled = false
        espTextEnabled = true
        rayEnabled = false
        
        -- 重置UI状态
        CombatTab:SetToggle("启用子弹追踪", false)
        CombatTab:SetToggle("队伍验证", false)
        CombatTab:SetToggle("好友验证", false)
        CombatTab:SetToggle("NPC追踪", false)
        CombatTab:SetToggle("FOV框", false)
        CombatTab:SetToggle("平滑自瞄", false)
        CombatTab:SetToggle("独立自瞄开关", false)
        EspTab:SetToggle("玩家透视", false)
        EspTab:SetToggle("文本显示", true)
        EspTab:SetToggle("射线追踪", false)
        EspTab:SetToggle("NPC透视", false)
        HighlightToggle:Set(false)
        RemoveFogToggle:Set(false)
        PlayerEspRangeSlider:Set(20)
        NpcEspRangeSlider:Set(20)
        CombatTab:SetSlider("自瞄范围", 300)
        CombatTab:SetSlider("自瞄平滑度", 0.08)
        CombatTab:SetSlider("FOV框大小", 10)
        VisualTab:SetSlider("视角FOV范围", 70)
        ThemeDropdown:Set("Dark")
        TransparencySlider:Set(0.2)
    end
})

local CloseButton = SettingsTab:Button({
    Title = "关闭脚本",
    Locked = false,
    Callback = function()
        -- 断开所有连接
        for _, conn in pairs(connections) do 
            if conn then 
                conn:Disconnect() 
            end 
        end
        
        -- 销毁所有ESP
        for _, data in pairs(PlayerHighlights) do 
            if data.Highlight then data.Highlight:Destroy() end 
            if data.Billboard then data.Billboard:Destroy() end 
        end
        for _, data in pairs(NPCHighlights) do 
            if data.Highlight then data.Highlight:Destroy() end 
            if data.Billboard then data.Billboard:Destroy() end 
        end
        
        -- 恢复光照设置
        Lighting.Brightness = originalLighting.Brightness
        Lighting.Ambient = originalLighting.Ambient
        Lighting.ColorShift_Top = originalLighting.ColorShift_Top
        Lighting.ColorShift_Bottom = originalLighting.ColorShift_Bottom
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.FogStart = originalLighting.FogStart
        Lighting.GlobalShadows = originalLighting.GlobalShadows
        
        -- 销毁FOV框
        if fovCircle then
            fovCircle:Destroy()
            fovCircle = nil
        end
        
        -- 销毁小窗自瞄UI
        if smallWindowAimbotUI then
            smallWindowAimbotUI:Destroy()
            smallWindowAimbotUI = nil
        end
        
        -- 销毁主UI
        Window:Destroy()
        
        -- 清除所有全局引用
        PlayerHighlights = nil
        NPCHighlights = nil
        connections = nil
        bulletTracking = nil
        smallWindowAimbotUI = nil
        fovCircle = nil
        
        print("三角洲项目xk V1 已完全关闭")
    end
})

