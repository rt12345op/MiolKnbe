-- 平滑自瞄
CombatTab:Toggle({
    Title = "平滑自瞄",
    Desc = "自动瞄准敌人",
    Type = "Checkbox",
    Default = false,
    Callback = function(state)
        aimbotEnabled = state
        if state then
            if smallWindowAimbotEnabled then
                smallWindowAimbotEnabled = false
                if smallWindowAimbotUI then
                    smallWindowAimbotUI:Destroy()
                    smallWindowAimbotUI = nil
                end
            end
            if not connections.aimbot then
                local targetHistory = {}
                local function FindTarget()
                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
                    local myRoot = char.HumanoidRootPart
                    local myPos = myRoot.Position
                    local closestTarget = nil
                    local shortestDist = AIM_MAX_RANGE
                    local bestPriority = math.huge
                    for _, player in pairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                            local targetRoot = player.Character.HumanoidRootPart
                            local targetHumanoid = player.Character:FindFirstChild("Humanoid")
                            local targetPos = targetRoot.Position
                            local dist = (myPos - targetPos).Magnitude
                            if dist < shortestDist then
                                local priority = 0
                                if targetHumanoid then
                                    priority = targetHumanoid.Health / targetHumanoid.MaxHealth
                                end
                                if priority < bestPriority then
                                    bestPriority = priority
                                    shortestDist = dist
                                    closestTarget = targetRoot
                                end
                            end
                        end
                    end
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") and not Players:GetPlayerFromCharacter(obj) then
                            local targetRoot = obj.HumanoidRootPart
                            local targetHumanoid = obj:FindFirstChild("Humanoid")
                            local targetPos = targetRoot.Position
                            local dist = (myPos - targetPos).Magnitude
                            if dist < shortestDist then
                                local priority = 0
                                if targetHumanoid then
                                    priority = targetHumanoid.Health / targetHumanoid.MaxHealth
                                end
                                if priority < bestPriority then
                                    bestPriority = priority
                                    shortestDist = dist
                                    closestTarget = targetRoot
                                end
                            end
                        end
                    end
                    return closestTarget
                end
                local function PredictPosition(target, currentPos)
                    local targetId = tostring(target:GetDebugId())
                    if not targetHistory[targetId] then
                        targetHistory[targetId] = {lastPos = currentPos, lastTime = tick(), velocity = Vector3.new(0, 0, 0)}
                        return currentPos
                    end
                    local history = targetHistory[targetId]
                    local currentTime = tick()
                    local deltaTime = currentTime - history.lastTime
                    if deltaTime > 0 then
                        local velocity = (currentPos - history.lastPos) / deltaTime
                        history.velocity = history.velocity:Lerp(velocity, 0.3)
                        local predictedPos = currentPos + (history.velocity * PREDICTION_TIME)
                        history.lastPos = currentPos
                        history.lastTime = currentTime
                        return predictedPos
                    end
                    return currentPos
                end
                connections.aimbot = RunService.RenderStepped:Connect(function()
                    if not aimbotEnabled then return end
                    local target = FindTarget()
                    if not target then return end
                    local currentPos = target.Position
                    local predictedPos = PredictPosition(target, currentPos)
                    local cameraPos = Camera.CFrame.Position
                    local direction = (predictedPos - cameraPos).Unit
                    local targetCFrame = CFrame.lookAt(cameraPos, cameraPos + direction)
                    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, AIM_SMOOTHNESS)
                end)
            end
        else
            if connections.aimbot then
                connections.aimbot:Disconnect()
                connections.aimbot = nil
            end
        end
    end
})

CombatTab:Slider({
    Title = "自瞄范围",
